{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noteshare-share-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-24",

  // 部署前请替换为你自己的 KV Namespace ID
  "kv_namespaces": [
    {
      "binding": "SHARES",
      "id": "1b52528c0330431e89611dd274fe67f3",
      "preview_id": "90f24114fbc647dd9fa2a2568c38531d"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "notelink"
    }
  ],

  "vars": {
    "R2_BUCKET_NAME": "notelink"
  }
}
